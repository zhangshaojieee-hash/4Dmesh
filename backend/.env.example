# =============================================
# 4D-Print 后端配置文件模板
# 复制此文件为 .env，然后填写对应的值
# =============================================

# 数据库配置（必填）
# 格式：mysql+pymysql://用户名:密码@地址:端口/数据库名
# 示例：mysql+pymysql://root:MyPassword123@localhost:3306/makerworld
DATABASE_URL=mysql+pymysql://root:请填写密码@localhost:3306/makerworld

# 如果继续使用 SQLite（不需要 MySQL），改为：
# DATABASE_URL=sqlite:///./makerworld.db

# JWT 认证密钥（必填）
JWT_SECRET_KEY=请替换为随机字符串

# Tripo 3D AI 密钥（必填，否则 AI 生成功能不可用）
TRIPO_API_KEY=

# OpenAI 密钥（可选）
OPENAI_API_KEY=

# Agnes AI 文本模型配置（可选）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# 科大讯飞语音配置（可选，语音功能需要）
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# 邮箱验证 SMTP（按需）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your@qq.com
# SMTP_PASSWORD=your_smtp_token
# SMTP_FROM=your@qq.com
# SMTP_USE_TLS=true

# 微信开放平台网站应用登录（按需）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=http://localhost:5173/login
# WECHAT_SCOPE=snsapi_login

# 跨域配置
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 运行目录
# DATA_DIR=/var/lib/4d-print
# UPLOAD_ROOT=/var/lib/4d-print/uploads

# 代理（按需）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# PrusaSlicer（按需）
PRUSASLICER_PATH=

# 模型查看器 HDR
MODEL_VIEWER_HDR_PATH=resources/viewer-environments/default.hdr
MODEL_VIEWER_HDR_URL=

# Klipper/Moonraker
MOONRAKER_URL=http://localhost:7125
